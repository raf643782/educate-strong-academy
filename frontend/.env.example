# Frontend environment variables (Vite). Copy this file to `.env.local`
# (dev) and fill in real values — `.env.local`/`.env.production` are
# gitignored and must never be committed.
#
# Every value in this file is safe to be public: Vite inlines VITE_* vars
# into the built client bundle, so nothing that must stay secret can ever
# go here or in any VITE_* variable. There is no write-capable or secret
# value anywhere on this list.

# Backend API base URL.
VITE_API_URL=http://localhost:3002/api

# Public canonical site origin — used for canonical URLs, Open Graph URLs,
# and structured data. Falls back to the production Vercel domain in code
# if unset, so this is only needed to override that (e.g. a custom domain).
VITE_SITE_URL=https://educate-strong-academy.vercel.app

# Sanity (Knowledge Hub content, Stage 1/5 — read-only, public dataset).
# projectId and dataset are NOT secret — they are the two values that
# identify which public Sanity dataset to read from, not credentials.
# No write token belongs here or anywhere in the frontend; this client
# is read-only by design (see frontend/src/lib/sanity.ts).
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_USE_CDN=true

# Internal QA demo login tooling — leave unset/false in every environment
# except when actively running handover QA. Requires the backend's own
# ENABLE_QA_DEMO_LOGIN + QA_DEMO_SECRET to also be set to do anything.
# MUST be unset before public launch.
VITE_ENABLE_QA_DEMO_LOGIN=false
