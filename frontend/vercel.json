{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/knowledge/is-strongman-safe-for-children", "destination": "/api/knowledge-draft-not-found" },
    { "source": "/exercises/:slug", "destination": "/api/library-not-found?type=exercise&slug=:slug" },
    { "source": "/events/:slug", "destination": "/api/library-not-found?type=event&slug=:slug" },
    { "source": "/(.*)", "destination": "/api/spa-fallback-or-404" }
  ]
}
