# Sanity Studio environment variables (this project only — separate from
# frontend/.env.local's VITE_SANITY_* vars, which the frontend reads instead).
#
# Copy this file to `.env` inside /sanity once a real Sanity project exists,
# and fill in the real project ID. Never commit the real .env file — it's
# already covered by the root .gitignore's `.env` pattern.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
