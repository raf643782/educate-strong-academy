generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  COACH
  TUTOR
  ASSESSOR
  ADMIN
}

enum Pathway {
  COACHING
  REFEREEING
  STRONGKIDZ
}

enum LessonType {
  TEXT
  VIDEO
  RESOURCE
  CASE_STUDY
  PRACTICAL_TASK
}

enum AssessmentType {
  KNOWLEDGE_EXAM
  WRITTEN_SCENARIO
  PROGRAMMING_ASSIGNMENT
  PRACTICAL_OBSERVATION
  JUDGING_SCENARIO
  SESSION_PLAN
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  PASSED
  FAILED
  REFERRED
  NEEDS_CHANGES
}

enum CPDActivity {
  FORMAL_LEARNING
  COACHING_EVENT
  COMPETITION
  OFFICIATING
  KNOWLEDGE_CONTRIBUTION
  MENTORING
  PEER_LEARNING
}

enum CPDStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentType {
  LESSON
  MODULE
  COURSE
  CERTIFICATION
  KB_ARTICLE
  EXERCISE
  EVENT
  BE_STRONG_ARTICLE
  BE_STRONG_HUB
  EXTERNAL_URL
}

enum BeStrongCategory {
  BASICS
  COMPETITION
  RECOVERY
  MAKING_WEIGHT
  HYDRATION
  SUPPLEMENTS
  COACHES_GUIDE
  YOUTH_NUTRITION
  DOWNLOADS
}

enum AccessLevel {
  FREE
  ENROLLED
  CERTIFIED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  firstName           String
  lastName            String
  role                Role      @default(LEARNER)
  isActive            Boolean   @default(true)
  avatarUrl           String?
  bio                 String?
  location            String?
  externalUserId      String?
  sourcePlatform      String?
  integrationProvider String?
  apiToken            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  enrolments            Enrolment[]
  lessonProgress        LessonProgress[]
  assessmentSubmissions AssessmentSubmission[]
  certificates          Certificate[]
  cpdLogs               CPDLog[]
  integrationLogs       IntegrationLog[]
  passwordResetTokens   PasswordResetToken[]
  coachProfile          CoachProfile?
}

model CoachProfile {
  id                   String   @id @default(uuid())
  userId               String?  @unique
  slug                 String   @unique
  displayName          String
  bio                  String?
  photoUrl             String?
  location             String?
  region               String?
  specialities         String[] @default([])
  qualificationSummary String?
  contactEmail         String?
  contactUrl           String?
  sortOrder            Int      @default(0)
  isVerified           Boolean  @default(false)
  isPublished          Boolean  @default(false)
  isArchived           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  description   String
  summary       String?
  pathway       Pathway
  level         Int       @default(1)
  imageUrl      String?
  durationHours Float?
  prerequisites String?
  isPublished   Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  modules      Module[]
  enrolments   Enrolment[]
  certificates Certificate[]
  assessments  Assessment[]
  documents    CourseDocument[]
  cohorts      Cohort[]
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id              String     @id @default(uuid())
  moduleId        String
  title           String
  content         String?
  type            LessonType @default(TEXT)
  videoUrl        String?
  resourceUrl     String?
  durationMinutes Int?
  sortOrder       Int        @default(0)
  isPublished     Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  module          Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]
  recommendations RecommendationPrompt[]
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  startedAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Enrolment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Assessment {
  id          String         @id @default(uuid())
  courseId    String?
  title       String
  description String?
  type        AssessmentType
  passMark    Int            @default(75)
  maxAttempts Int            @default(3)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  course      Course?               @relation(fields: [courseId], references: [id])
  submissions AssessmentSubmission[]
}

model AssessmentSubmission {
  id           String           @id @default(uuid())
  assessmentId String
  userId       String
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  gradedById   String?

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}

model Certificate {
  id              String    @id @default(uuid())
  userId          String
  courseId        String
  certificateCode String    @unique
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime?
  webhookStatus   String?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model CPDLog {
  id           String      @id @default(uuid())
  userId       String
  activityType CPDActivity
  description  String
  hoursEarned  Float
  evidenceUrl  String?
  status       CPDStatus   @default(PENDING)
  loggedAt     DateTime    @default(now())
  approvedAt   DateTime?
  approvedById String?

  user User @relation(fields: [userId], references: [id])
}

model KnowledgeArticle {
  id             String      @id @default(uuid())
  title          String
  slug           String      @unique
  category       String
  subcategory    String?
  summary        String?
  content        String?
  authorName     String?
  lastReviewedAt DateTime?
  isPublished    Boolean     @default(false)
  accessLevel    AccessLevel @default(FREE)
  imageUrl       String?
  readMinutes    Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Exercise {
  id               String     @id @default(uuid())
  name             String
  slug             String     @unique
  category         String
  difficulty       Difficulty @default(INTERMEDIATE)
  description      String?
  techniqueNotes   String?
  coachingCues     String?
  commonMistakes   String?
  progressions     String?
  regressions      String?
  programmingNotes String?
  videoUrl         String?
  equipmentNeeded  String?
  musclesWorked    String?
  safetyNotes      String?
  isCompetitionEvent Boolean  @default(false)
  isPublished      Boolean    @default(false)
  isLaunchPriority Boolean    @default(false)
  // Stage 6 media infrastructure — all nullable, additive. Left empty
  // until real assets exist; the frontend never fabricates a thumbnail
  // or video from an empty field.
  imageUrl           String?
  imageAlt           String?
  videoProvider      String?
  videoThumbnailUrl  String?
  videoTitle         String?
  videoDescription   String?
  videoUploadDate    DateTime?
  videoDuration      String?
  videoTranscript    String?
  captionsUrl        String?
  // Stage 7 editorial attribution, sources and related content — all
  // nullable/empty-array, additive. Left empty until a real author,
  // reviewer, source, or curated relationship is confirmed; the
  // frontend never invents or auto-assigns a name here.
  authorName             String?
  authorRole             String?
  reviewerName           String?
  reviewerQualification  String?
  publishedDate          DateTime?
  lastReviewedDate       DateTime?
  sources                String?
  relatedExerciseSlugs   String[]  @default([])
  relatedEventSlugs      String[]  @default([])
  relatedArticleSlugs    String[]  @default([])
  relevantCourseSlugs    String[]  @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Event {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  category         String
  description      String?
  technicalNotes   String?
  coachingNotes    String?
  judgingCriteria  String?
  programmingNotes String?
  commonErrors     String?
  videoUrl         String?
  isPublished      Boolean  @default(false)
  isLaunchPriority Boolean  @default(false)
  // Stage 6 media infrastructure — all nullable, additive. Left empty
  // until real assets exist; the frontend never fabricates a thumbnail
  // or video from an empty field.
  imageUrl           String?
  imageAlt           String?
  videoProvider      String?
  videoThumbnailUrl  String?
  videoTitle         String?
  videoDescription   String?
  videoUploadDate    DateTime?
  videoDuration      String?
  videoTranscript    String?
  captionsUrl        String?
  // Stage 7 editorial attribution, sources and related content — all
  // nullable/empty-array, additive. Left empty until a real author,
  // reviewer, source, or curated relationship is confirmed; the
  // frontend never invents or auto-assigns a name here. ruleReviewDate
  // is Event-only — the date a promoter/federation rule summary was
  // last confirmed as current, distinct from general editorial review.
  authorName             String?
  authorRole             String?
  reviewerName           String?
  reviewerQualification  String?
  publishedDate          DateTime?
  lastReviewedDate       DateTime?
  ruleReviewDate         DateTime?
  sources                String?
  relatedExerciseSlugs   String[]  @default([])
  relatedEventSlugs      String[]  @default([])
  relatedArticleSlugs    String[]  @default([])
  relevantCourseSlugs    String[]  @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContentRelationship {
  id               String      @id @default(uuid())
  sourceType       ContentType
  sourceId         String
  targetType       ContentType
  targetId         String
  relationshipType String
  displayLabel     String?
  priority         Int         @default(3)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model RecommendationPrompt {
  id             String      @id @default(uuid())
  lessonId       String?
  triggerContext String?
  promptLabel    String
  targetType     ContentType
  targetId       String?
  targetUrl      String?
  ctaText        String
  position       String      @default("end_of_lesson")
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  lesson Lesson? @relation(fields: [lessonId], references: [id])
}

model IntegrationLog {
  id             String    @id @default(uuid())
  userId         String
  eventType      String
  targetPlatform String
  payload        Json
  status         String    @default("pending")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Be Strong Nutrition Section ──────────────────────────────────────────────

model BeStrongArticle {
  id                    String           @id @default(uuid())
  title                 String
  slug                  String           @unique
  category              BeStrongCategory
  subcategory           String?
  summary               String?
  content               String?
  // Authorship — nutrition content must be attributed to a qualified reviewer
  authorName            String?
  reviewerName          String?
  reviewerQualification String?          // e.g. "Registered Dietitian", "SENr Practitioner"
  lastReviewedAt        DateTime?
  // Scope of practice disclaimer shown at article top
  scopeOfPracticeNote   String?
  // Access control
  accessLevel           AccessLevel      @default(FREE)
  isPremium             Boolean          @default(false)  // reserved for future paid tier
  isPublished           Boolean          @default(false)
  isFeatured            Boolean          @default(false)
  readMinutes           Int?
  imageUrl              String?
  tags                  String?          // comma-separated
  // Related content (stored as JSON arrays of IDs)
  relatedArticleSlugs   String?
  relatedCourseSlugs    String?
  sortOrder             Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model BeStrongDownload {
  id           String           @id @default(uuid())
  title        String
  slug         String           @unique
  description  String?
  category     BeStrongCategory
  fileType     String           @default("PDF")  // PDF, Excel, Word
  fileUrl      String?
  thumbnailUrl String?
  accessLevel  AccessLevel      @default(ENROLLED)
  isPublished  Boolean          @default(false)
  downloadCount Int             @default(0)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ─── Course Documents ─────────────────────────────────────────────────────────

enum DocumentType {
  HANDBOOK
  ASSESSMENT_FORM
  CHECKLIST
  RESOURCE
  CERTIFICATE
  TEMPLATE
  OTHER
}

enum DocumentStatus {
  AVAILABLE    // learner can access
  LOCKED       // only unlocked on completion
  COMING_SOON  // placeholder — file not yet uploaded
}

model CourseDocument {
  id          String         @id @default(uuid())
  courseId    String?        // null = platform-wide resource
  title       String
  description String?
  type        DocumentType   @default(RESOURCE)
  status      DocumentStatus @default(AVAILABLE)
  fileUrl     String?        // Stage 4C: private Cloudflare R2 object key, NOT a
                              // public URL — the column name is unchanged to avoid
                              // a migration, but the value is a key resolved to a
                              // short-lived signed GET URL on download. Null until
                              // a file has been uploaded through the admin flow.
  fileType    String         @default("PDF")
  fileSizeMb  Float?
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  course Course? @relation(fields: [courseId], references: [id])
}

// ── Cohorts ───────────────────────────────────────────────────────────────────

enum CohortStatus {
  UPCOMING
  CONFIRMED
  FULL
  COMPLETED
  CANCELLED
}

model Cohort {
  id          String       @id @default(uuid())
  courseId    String?
  title       String
  status      CohortStatus @default(UPCOMING)
  city        String?
  venue       String?
  date        DateTime?
  capacity    Int?
  bookingUrl  String?
  isConfirmed Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ── Homepage venue map + spotlight ──────────────────────────────────────
  // `venue` (name), `city`, `date` (start), `status` (booking status),
  // `bookingUrl`, `isConfirmed` and `sortOrder` (homepage priority) are
  // reused as-is above rather than duplicated here. All fields below are
  // optional and default to values that keep every existing cohort exactly
  // as it behaves today — in particular `featuredOnHomepage` defaults to
  // false, so no existing row starts appearing on the homepage.
  addressLine         String?
  postcode            String?
  latitude            Float?
  longitude           Float?
  directionsUrl       String?
  featuredOnHomepage  Boolean   @default(false)
  endDate             DateTime?
  startTime           String?
  finishTime          String?
  price               Float?
  availableSpaces     Int?
  registerInterestUrl String?
  shortDescription    String?

  course Course? @relation(fields: [courseId], references: [id])
}

// ── Register Interest ─────────────────────────────────────────────────────────

enum InterestStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

model RegisterInterest {
  id               String         @id @default(uuid())
  firstName        String
  lastName         String
  email            String
  phone            String?
  courseInterest   String?
  locationInterest String?
  message          String?
  sourcePage       String?
  status           InterestStatus @default(NEW)
  createdAt        DateTime       @default(now())
}
