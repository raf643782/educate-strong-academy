DATABASE_URL="postgresql://postgres:password@localhost:5432/educate_strong"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Email (SMTP) — required for production password reset emails
# Leave blank in development; the reset link will be logged to the console instead.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="EducateStrong Academy <no-reply@educatestrong.com>"

# QA demo login — TEMPORARY internal tooling, disabled by default.
# Only enable while running handover QA. Disable both before public launch.
# QA_DEMO_SECRET must be a private value you generate yourself — never commit it.
ENABLE_QA_DEMO_LOGIN=false
QA_DEMO_SECRET=
